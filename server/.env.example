# Required: a random secret, at least 24 characters. The tablet's Settings screen uses the same value.
# Generate one: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
API_KEY=replace-with-a-long-random-value

# Where sign-ins are stored (SQLite file).
DATABASE_FILE=leads.db

PORT=8787

# Browsers/apps allowed to call the API. The first entry is the Android app itself.
ALLOWED_ORIGINS=https://appassets.androidplatform.net,http://localhost:5173
